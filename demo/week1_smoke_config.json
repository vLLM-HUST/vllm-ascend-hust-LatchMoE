{
  "suite": "week1-smoke-20260630",
  "description": "Week-1 reproducibility smoke suite for the SEW-Offload CCF-A systems paper plan. This suite is intentionally tiny and is not a paper-result benchmark.",
  "model": "/data/shared_models/modelscope_cache/Qwen/Qwen3-30B-A3B",
  "served_model_name": "qwen3-30b-a3b",
  "host": "127.0.0.1",
  "port": 8026,
  "dataset": "/data/shared_datasets/ShareGPT_V3_unfiltered_cleaned_split.json",
  "tokenizer": "/data/shared_models/modelscope_cache/Qwen/Qwen3-30B-A3B",
  "bench": {
    "n_prompts": 1,
    "max_tokens": 8,
    "max_prompt_chars": 512,
    "concurrency": 1,
    "seed": 42,
    "request_timeout_s": 600
  },
  "server": {
    "command": "vllm",
    "common_args": [
      "serve",
      "{model}",
      "--served-model-name",
      "{served_model_name}",
      "--trust-remote-code",
      "--dtype",
      "bfloat16",
      "--tensor-parallel-size",
      "1",
      "--host",
      "{host}",
      "--port",
      "{port}",
      "--max-num-seqs",
      "1",
      "--max-model-len",
      "1024",
      "--max-num-batched-tokens",
      "1024",
      "--gpu-memory-utilization",
      "0.90"
    ],
    "startup_timeout_s": 1200,
    "shutdown_timeout_s": 30
  },
  "cases": [
    {
      "name": "no_offload_capacity_probe",
      "role": "baseline",
      "description": "No-offload capacity probe. Success is useful but failure/OOM is also an expected feasibility signal under a single-card HBM budget.",
      "env": {
        "ASCEND_RT_VISIBLE_DEVICES": "4",
        "VLLM_ASCEND_MOE_OFFLOAD_GB": "",
        "VLLM_ASCEND_MOE_OFFLOAD_SEW_DATAPLANE": "",
        "VLLM_ASCEND_MOE_OFFLOAD_ENABLED": ""
      }
    },
    {
      "name": "native_prefetch_14gb",
      "role": "baseline",
      "description": "Native vLLM/vLLM-Ascend prefetch offload baseline with a 14 GiB expert offload setting. This case must not mix with SEW dataplane env.",
      "server_args": [
        "--offload-backend",
        "prefetch",
        "--cpu-offload-gb",
        "14",
        "--offload-params",
        "experts",
        "--offload-group-size",
        "4",
        "--offload-num-in-group",
        "1",
        "--offload-prefetch-step",
        "1"
      ],
      "env": {
        "ASCEND_RT_VISIBLE_DEVICES": "4",
        "VLLM_ASCEND_MOE_OFFLOAD_GB": "",
        "VLLM_ASCEND_MOE_OFFLOAD_SEW_DATAPLANE": "0",
        "VLLM_ASCEND_MOE_OFFLOAD_ENABLED": ""
      }
    },
    {
      "name": "legacy_layered_14gb",
      "role": "baseline",
      "description": "Plugin AutoConfig legacy/layered path: enables the offload GB policy without selecting the graph-compatible SEW dataplane.",
      "env": {
        "ASCEND_RT_VISIBLE_DEVICES": "4",
        "VLLM_ASCEND_MOE_OFFLOAD_GB": "14",
        "VLLM_ASCEND_MOE_OFFLOAD_SEW_DATAPLANE": "0",
        "VLLM_ASCEND_MOE_OFFLOAD_MAX_NUM_SEQS_HINT": "1"
      }
    },
    {
      "name": "sew_14gb_slots32",
      "role": "main",
      "description": "SEW fixed-slot dataplane with a 14 GiB target offload budget. AutoConfig is expected to select roughly 32 slots for Qwen3-30B-A3B.",
      "env": {
        "ASCEND_RT_VISIBLE_DEVICES": "4",
        "VLLM_ASCEND_MOE_OFFLOAD_GB": "14",
        "VLLM_ASCEND_MOE_OFFLOAD_SEW_DATAPLANE": "1",
        "VLLM_ASCEND_MOE_OFFLOAD_MAX_NUM_SEQS_HINT": "1",
        "VLLM_ASCEND_MOE_OFFLOAD_B2_WAVE_PREFILL": "1",
        "VLLM_ASCEND_MOE_OFFLOAD_TRANSFER_AWARE_SCHEDULE": "1",
        "VLLM_ASCEND_MOE_OFFLOAD_CPU_FIRST_LOAD": "1"
      }
    }
  ]
}
