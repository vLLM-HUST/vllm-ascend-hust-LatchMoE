{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEW-Offload Ascend benchmark config",
  "type": "object",
  "required": [
    "benchmark",
    "model",
    "dataset",
    "server",
    "client",
    "serving_shape",
    "workload_buckets",
    "cases",
    "experiments",
    "metrics",
    "artifact_contract"
  ],
  "properties": {
    "benchmark": {
      "type": "object",
      "required": ["id", "config_version", "suite"],
      "properties": {
        "id": {"type": "string"},
        "config_version": {"type": "integer"},
        "suite": {"type": "string"}
      }
    },
    "model": {
      "type": "object",
      "required": ["name", "served_model_name", "path", "tokenizer", "tensor_parallel_size"],
      "properties": {
        "name": {"type": "string"},
        "served_model_name": {"type": "string"},
        "path": {"type": "string"},
        "tokenizer": {"type": "string"},
        "tensor_parallel_size": {"type": "integer"}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["source", "local_path", "manifest_path", "seed"],
      "properties": {
        "source": {"const": "sharegpt"},
        "local_path": {"type": "string"},
        "manifest_path": {"type": "string"},
        "seed": {"type": "integer"},
        "random_dataset_allowed": {"const": false},
        "synthetic_smoke_allowed": {"const": false}
      }
    },
    "workload_buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "prompt_tokens", "output_tokens", "num_requests"],
        "properties": {
          "name": {"type": "string"},
          "prompt_tokens": {
            "oneOf": [
              {"const": "mixed"},
              {
                "type": "array",
                "prefixItems": [{"type": "integer"}, {"type": "integer"}],
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "output_tokens": {"type": "integer", "minimum": 1},
          "num_requests": {"type": "integer", "minimum": 1}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "experiment_groups", "env"],
        "properties": {
          "name": {"type": "string"},
          "role": {"enum": ["baseline", "main", "ablation", "sensitivity"]},
          "experiment_groups": {
            "type": "array",
            "items": {"type": "string"}
          },
          "server_args": {
            "type": "array",
            "items": {"type": "string"}
          },
          "env": {"type": "object"}
        }
      }
    }
  }
}
